      "id": "df06e0de-94a6-42b2-bf01-73386563e2c7",
      "name": "Extract from File1"
    },
    {
      "parameters": {
        "jsCode": "const text = String($json.text || '').trim();\n\nconst fileName = String($json.fileName || '').trim();\n\nfunction clean(value) {\n  return String(value || '')\n    .replace(/\\r/g, '')\n    .replace(/[ \\t]+/g, ' ')\n    .trim();\n}\n\nconst lines = text\n  .split('\\n')\n  .map(clean)\n  .filter(Boolean);\n\n// ---------- TITLE ----------\nlet title = '';\n\nconst titleMatch = text.match(\n  /^(?:Case Study|Resource)\\s*:\\s*(.+?)(?:\\n|$)/i\n);\n\nif (titleMatch) {\n  title = clean(titleMatch[1]);\n}\n\n// Keep full title from the next line when PDF wraps it.\nif (title && lines.length > 1) {\n  const firstLine = lines[0];\n\n  if (\n    /^(?:Case Study|Resource)\\s*:/i.test(firstLine) &&\n    !firstLine.toLowerCase().includes(lines[1].toLowerCase())\n  ) {\n    title = clean(`${title} ${lines[1]}`);\n  }\n}\n\nif (!title) {\n  title = clean(\n    fileName\n      .replace(/\\.[^/.]+$/, '')\n      .replace(/^(casestudy_|resource_)/i, '')\n      .replace(/[_-]+/g, ' ')\n  );\n}\n\n// ---------- DESCRIPTION ----------\nlet description = '';\n\nconst descStart = lines.findIndex(line =>\n  /^(?:This is|A |An |The )/i.test(line)\n);\n\nif (descStart !== -1) {\n  const descriptionLines = [];\n\n  for (let i = descStart; i < lines.length; i++) {\n    const line = lines[i];\n\n    if (\n      /^(?:The challenge|The operating requirements|The Leadnius workflow|What this workflow changes|Where Leadnius fits|Takeaway)$/i.test(line)\n    ) {\n      break;\n    }\n\n    descriptionLines.push(line);\n  }\n\n  description = clean(descriptionLines.join(' '));\n}\n\n// Fallback: first meaningful paragraph after title/subtitle.\nif (!description) {\n  const intro = lines.slice(1, 6)\n    .filter(line =>\n      line.length > 40 &&\n      !/^Leadnius\\s*[—-]/i.test(line)\n    );\n\n  description = clean(intro.join(' '));\n}\n\nif (description.length > 220) {\n  description = description.slice(0, 217).replace(/\\s+\\S*$/, '') + '...';\n}\n\n// ---------- KEY POINTS ----------\nconst points = [];\n\n// Normalize PDF bullet formatting.\n// Example:\n// •\n// Identify accounts...\n//\n// becomes:\n// Identify accounts...\nconst normalizedText = text\n  .replace(/[•▪◦]\\s*\\n\\s*/g, '• ')\n  .replace(/\\n\\s*•\\s*/g, '\\n• ');\n\nconst normalizedLines = normalizedText\n  .split('\\n')\n  .map(clean)\n  .filter(Boolean);\n\n// 1. Extract real bullet points.\nfor (const line of normalizedLines) {\n  const match = line.match(/^[•▪◦*-]\\s+(.+)$/);\n\n  if (match) {\n    const point = clean(match[1]);\n\n    if (\n      point.length >= 20 &&\n      point.length <= 220 &&\n      !points.some(p => p.toLowerCase() === point.toLowerCase())\n    ) {\n      points.push(point);\n    }\n  }\n\n  if (points.length >= 5) break;\n}\n\n// 2. If there are not enough bullets, use numbered/stage sections.\nif (points.length < 3) {\n  const stages = normalizedLines.filter(line =>\n    /^Stage\\s+\\d+/i.test(line)\n  );\n\n  for (const stage of stages) {\n    if (!points.includes(stage)) {\n      points.push(stage);\n    }\n\n    if (points.length >= 5) break;\n  }\n}\n\n// Maximum 5.\nconst keyPoints = points.slice(0, 5);\n\n// ---------- WEBSITE CONTENT ----------\nconst content = `\n<h2>Key Highlights</h2>\n<ul>\n${keyPoints.map(point => `<li>${point}</li>`).join('\\n')}\n</ul>\n`.trim();\n\nreturn {\n  json: {\n    ...$json,\n    title,\n    description,\n    keyPoints,\n    content\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        64
      ],
      "id": "e1b8ebae-3853-45d1-8eed-a3e2a2c522be",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "const resource = $('Edit Fields1').first().json;\n\n// Replace this with your actual website domain\nconst websiteBaseUrl = 'http://localhost:3000';\n\nconst websiteUrl = `${websiteBaseUrl}/resources/automation/${resource.id}`;\n\nconst slackMessage = `🚀 New resource published!\n\n${resource.title}\n\n${resource.description}\n\n🌐 Website: ${websiteUrl}\n📄 PDF: ${resource.downloadUrl}`;\n\nreturn [\n  {\n    json: {\n      ...resource,\n      websiteUrl,\n      slackMessage\n    }\n  }\n];"
      },
