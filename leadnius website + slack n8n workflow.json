      "parameters": {
        "jsCode": "const resources = $input.first().json.resources;\nconst newResource = $('Edit Fields1').first().json;\n\n// Remove existing resource with the same resourceKey\nconst filteredResources = resources.filter(\n  resource => resource.resourceKey !== newResource.resourceKey\n);\n\n// Add the latest version at the top\nreturn [\n  {\n    json: {\n      resources: [newResource, ...filteredResources],\n    },\n  },\n];"
      },
