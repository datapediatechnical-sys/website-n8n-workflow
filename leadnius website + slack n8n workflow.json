        "jsCode": "const content = $input.first().json.content;\n\nconst decoded = Buffer.from(content, 'base64').toString('utf8');\n\nconst resources = JSON.parse(decoded);\n\nreturn [\n  {\n    json: {\n      resources,\n    },\n  },\n];"
